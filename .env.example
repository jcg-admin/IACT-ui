# API Configuration
REACT_APP_API_URL=http://localhost:8000

# WebSocket Configuration
REACT_APP_WS_URL=ws://localhost:8080

# Mock Configuration (Development only)
# Set to 'true' para usar mocks en lugar de backend real
REACT_APP_USE_MOCKS=true

# Storage Configuration
REACT_APP_STORAGE_SECRET=dev-secret-key-change-in-production

# Cookie Configuration
REACT_APP_COOKIE_DOMAIN=localhost

# Environment
NODE_ENV=development

# Logging
REACT_APP_LOG_LEVEL=debug

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_SENTRY=false
